# Copia este archivo como .env y reemplaza los cuatro secretos vacios antes de
# ejecutar `docker compose up --build`. Para generar secretos URL-safe:
#   openssl rand -hex 32

POSTGRES_USER=isi
POSTGRES_PASSWORD=
POSTGRES_DB=isi_portal

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Clave independiente para cifrar TOTP: openssl rand -hex 32
# Conservar con los respaldos. No rotarla sin recifrar los secretos existentes.
TOTP_ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_ABSOLUTE_TTL=30d
ENABLE_SWAGGER=false
# Solo para una demo con WEB_ORIGIN en localhost. Muestra enlaces de
# verificación/recuperación en pantalla porque aún no hay proveedor de correo.
AUTH_DEV_LINKS=true
# Para correo real: AUTH_DEV_LINKS=false y SMTP configurado.
# Gmail: smtp.gmail.com, puerto 465 y contraseña de aplicación (no la principal).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SICI Univalle
# Alternativa a SMTP: webhook HTTPS { to, type, actionUrl, expiresAt }.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
# Canal separado para alertas de auditoría de proyectos. El receptor obtiene
# un JSON mínimo firmado por HMAC; fuera de localhost debe usar HTTPS.
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_SECRET=
SEED_ON_FIRST_RUN=true
# Debe seguir en false; solo confirma conscientemente un seed demo no local.
ALLOW_DEMO_SEED=false

WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_WEB_URL=http://localhost:3000
# 1 para Next -> API en Docker local o Nginx -> API en producción.
# Si Nginx envía /api a Next, son 2 proxies. Ver docs/IDENTIDAD-Y-DESPLIEGUE.md.
TRUST_PROXY_HOPS=1
# Compose deriva PUBLIC_API_URL y NEXT_PUBLIC_SITE_URL de PUBLIC_WEB_URL.
# El navegador siempre usa /api; NEXT_PUBLIC_API_URL ya no se utiliza.

API_PORT=4000
WEB_PORT=3000

STORAGE_DRIVER=local
UPLOADS_PER_USER_PER_DAY=25
# Cuota total por usuario en bytes (250 MiB por defecto).
STORAGE_BYTES_PER_USER=262144000
# Limpia al arrancar archivos sin vínculo ni referencia con más de 24 horas.
CLEAN_ORPHAN_UPLOADS_ON_START=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
